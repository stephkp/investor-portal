- if investors.any?
  .card.card--table
    %table.table
      %thead
        %tr
          %th Name
          %th Phone
          %th Location
          %th SSN
          %th Documents
          %th Actions
      %tbody
        - investors.each do |investor|
          %tr
            %td.table__primary= "#{investor.first_name} #{investor.last_name}"
            %td= investor.phone_number
            %td= "#{investor.city}, #{investor.state} #{investor.zip_code}"
            %td
              - if investor.documents.attached?
                - investor.documents.each do |document|
                  .mb-1
                    = link_to 'Download', rails_blob_path(document, disposition: "inline"), target: '_blank', class: 'btn btn--secondary btn--sm'
              - else
                | No documents
            %td
              .btn-row
                = link_to 'View', investor_path(investor), class: 'btn btn--secondary btn--sm'
                = link_to 'Edit', edit_investor_path(investor), class: 'btn btn--secondary btn--sm'
- else
  .page__status
    No investors found.
    = link_to 'Add Your First Investor', new_investor_path, class: 'btn btn--primary'
