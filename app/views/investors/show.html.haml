%section.page.page--narrow
  .page__header
    %h2.page__title Investor Information

  .card
    %table.table
      %tbody
        %tr
          %th Name:
          %td.table__primary= "#{@investor.first_name} #{@investor.last_name}"
        %tr
          %th Date of Birth:
          %td= @investor.date_of_birth&.strftime('%m/%d/%Y')
        %tr
          %th Phone Number:
          %td= @investor.phone_number
        %tr
          %th SSN:
          %td= masked_ssn(@investor.ssn)
        %tr
          %th Address:
          %td
            = @investor.street_address
            %br/
            = "#{@investor.state} #{@investor.zip_code}"
        %tr
          %th Created:
          %td= @investor.created_at

    - if @investor.documents.attached?
      .investor-detail__files
        %h4 Uploaded Files:
        %ul.existing-documents__list
          - @investor.documents.each do |document|
            %li.existing-documents__item
              = link_to document.filename, rails_blob_path(document, disposition: "inline"), target: '_blank', rel: 'noopener', class: 'existing-documents__link'
              %span.existing-documents__size
                (#{number_to_human_size(document.byte_size)})

    .investor-detail__actions
      = link_to 'Add Another Investor', new_investor_path, class: 'btn btn--primary'
      = link_to 'View All Investors', investors_path, class: 'btn btn--secondary'